{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilos.x-lab/schemas/evidence_source.schema.json",
  "title": "X-LAB Evidence Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "domains", "source_type", "access", "homepage"],
  "properties": {
    "id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 2},
    "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "source_type": {"type": "string", "enum": ["registry", "dataset_repository", "archive", "knowledge_base", "mixed"]},
    "access": {"type": "string", "enum": ["open", "mixed", "restricted"]},
    "homepage": {"type": "string", "minLength": 8},
    "api_available": {"type": "boolean"},
    "doi_support": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}
