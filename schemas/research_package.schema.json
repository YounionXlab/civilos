{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilos.x-lab/schemas/research_package.schema.json",
  "title": "X-LAB Research Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "title", "question_ids", "experiment_ids", "runtime", "reproducibility_status", "evidence_level", "publication_status"],
  "properties": {
    "package_id": {"type": "string", "pattern": "^PKG-[A-Z]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3},
    "question_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^Q-[0-9]{3}$"}, "uniqueItems": true},
    "preregistration_ids": {"type": "array", "items": {"type": "string", "pattern": "^PRE-EXP-[A-Z]+-[0-9]{3}-[0-9]{3}$"}, "uniqueItems": true},
    "experiment_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EXP-[A-Z]+-[0-9]{3}$"}, "uniqueItems": true},
    "result_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "report_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "insight_ids": {"type": "array", "items": {"type": "string", "pattern": "^INS-[0-9]{3,}$"}, "uniqueItems": true},
    "evidence_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVI-[A-Z]+-[0-9]{3}$"}, "uniqueItems": true},
    "runtime": {"type": "string", "minLength": 2},
    "code_version": {"type": ["string", "null"]},
    "reproducibility_status": {"type": "string", "enum": ["not_assessed", "partial", "reproducible", "independently_reproduced"]},
    "experiment_quality_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "evidence_level": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "publication_status": {"type": "string", "enum": ["internal", "draft", "public", "archived"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
