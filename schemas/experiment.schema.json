{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilos.x-lab/schemas/experiment.schema.json",
  "title": "X-LAB Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "runtime", "status", "questions", "hypothesis", "initial_conditions", "metrics", "observation_window"],
  "properties": {
    "id": {"type": "string", "pattern": "^EXP-[A-Z]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3},
    "runtime": {"type": "string", "minLength": 2},
    "status": {"type": "string", "enum": ["candidate", "planned", "active", "paused", "completed", "archived"]},
    "questions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^Q-[0-9]{3}$"}, "uniqueItems": true},
    "hypothesis": {"type": "string", "minLength": 10},
    "world_seed": {"type": ["string", "null"]},
    "random_seed": {"type": ["integer", "null"]},
    "initial_conditions": {"type": "object"},
    "variables": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "interventions": {"type": "array", "items": {"type": "string"}},
    "observation_window": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "integer", "minimum": 1},
        "unit": {"type": "string", "enum": ["tick", "sol", "day", "year", "generation"]}
      },
      "additionalProperties": false
    },
    "success_signals": {"type": "array", "items": {"type": "string"}},
    "failure_signals": {"type": "array", "items": {"type": "string"}},
    "result": {"type": ["string", "null"], "enum": ["supported", "partially_supported", "not_supported", "inconclusive", null]}
  }
}
