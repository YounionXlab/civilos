{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilos.x-lab/schemas/insight.schema.json",
  "title": "X-LAB Research Insight",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "statement", "source_experiments", "source_questions", "confidence", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^INS-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 3},
    "statement": {"type": "string", "minLength": 10},
    "source_experiments": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EXP-[A-Z]+-[0-9]{3}$"}, "uniqueItems": true},
    "source_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^Q-[0-9]{3}$"}, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["provisional", "supported", "contested", "superseded", "validated"]},
    "evidence_level": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "experiment_quality_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "replications": {"type": "integer", "minimum": 0},
    "independent_replication": {"type": "boolean"},
    "external_datasets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_references": {"type": "array", "items": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"}, "uniqueItems": true},
    "model_domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "model_evidence": {"type": "array", "items": {"type": "string"}},
    "experimental_inference": {"type": "array", "items": {"type": "string"}},
    "real_world_implication": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "implications": {"type": "array", "items": {"type": "string"}},
    "decision_relevance": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
